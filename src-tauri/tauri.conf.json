{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "班级成绩管理系统",
  "version": "1.0.0",
  "identifier": "cn.grade.manager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "班级成绩管理系统",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "MVP Dev Expert Team"
  }
}
